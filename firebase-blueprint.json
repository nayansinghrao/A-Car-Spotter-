{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile document",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User Google email address" },
        "displayName": { "type": "string", "description": "User display name" },
        "currentGarageId": { "type": "string", "description": "Current active garage ID" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp()" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "Garage": {
      "title": "Garage",
      "description": "Private two-person automotive spotting garage",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Garage unique identifier" },
        "name": { "type": "string", "description": "Name of the garage" },
        "ownerUid": { "type": "string", "description": "UID of the garage creator/owner" },
        "ownerEmail": { "type": "string", "description": "Email of the owner" },
        "memberUids": {
          "type": "array",
          "description": "List of authorized member UIDs (maximum 2)",
          "items": { "type": "string" }
        },
        "inviteCode": { "type": "string", "description": "Alphanumeric code to join the garage" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp()" }
      },
      "required": ["id", "name", "ownerUid", "memberUids", "inviteCode", "createdAt", "updatedAt"]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "Owner-approved join request for the second member",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Request identifier (user UID)" },
        "garageId": { "type": "string", "description": "Target garage ID" },
        "uid": { "type": "string", "description": "UID of requester" },
        "email": { "type": "string", "description": "Email of requester" },
        "displayName": { "type": "string", "description": "Display name of requester" },
        "inviteCodeSubmitted": { "type": "string", "description": "Code submitted by requester" },
        "status": { "type": "string", "description": "pending, approved, or rejected" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Request creation timestamp" }
      },
      "required": ["id", "garageId", "uid", "email", "status", "createdAt"]
    },
    "Sighting": {
      "title": "Sighting",
      "description": "A vehicle sighting record in the shared garage",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Sighting unique identifier" },
        "garageId": { "type": "string", "description": "ID of garage" },
        "createdBy": { "type": "string", "description": "UID of contributor" },
        "creatorName": { "type": "string", "description": "Display name or email of contributor" },
        "category": { "type": "string", "description": "Vehicle category" },
        "brand": { "type": "string", "description": "Vehicle brand/make" },
        "model": { "type": "string", "description": "Vehicle model name" },
        "numberPlateRaw": { "type": "string", "description": "Raw unformatted plate text" },
        "numberPlateNormalized": { "type": "string", "description": "Normalized uppercase alphanumeric plate text" },
        "plateOcrStatus": { "type": "string", "description": "OCR status indicator" },
        "imagePaths": { "type": "array", "description": "List of photo data or storage URLs", "items": { "type": "string" } },
        "primaryImagePath": { "type": "string", "description": "Primary display image" },
        "locationName": { "type": "string", "description": "Human readable location label" },
        "area": { "type": "string", "description": "Locality or area" },
        "city": { "type": "string", "description": "City name" },
        "latitude": { "type": "number", "description": "GPS latitude" },
        "longitude": { "type": "number", "description": "GPS longitude" },
        "sightingDate": { "type": "string", "description": "Date of sighting (YYYY-MM-DD)" },
        "sightingTime": { "type": "string", "description": "Time of sighting (HH:mm)" },
        "notes": { "type": "string", "description": "Additional notes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation timestamp via serverTimestamp()" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Update timestamp via serverTimestamp()" }
      },
      "required": [
        "id", "garageId", "createdBy", "category", "brand", "model",
        "numberPlateNormalized", "primaryImagePath", "latitude", "longitude",
        "sightingDate", "sightingTime", "createdAt", "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/garages/{garageId}": {
      "schema": "Garage",
      "description": "Private garages"
    },
    "/garages/{garageId}/joinRequests/{requestId}": {
      "schema": "JoinRequest",
      "description": "Owner approval join requests"
    },
    "/garages/{garageId}/sightings/{sightingId}": {
      "schema": "Sighting",
      "description": "Vehicle sightings belonging to the garage"
    }
  }
}
